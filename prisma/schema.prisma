// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Policy {
  id         String @id // Use custom IDs like POL-001
  name       String
  source     String
  destination String
  action     PolicyAction // 'Allow' | 'Deny'
  status     PolicyStatus // 'Active' | 'Inactive' | 'Pending Approval'
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Vendor-specific fields
  vendor     String?     // 'fortigate', 'paloalto', 'cisco', etc.
  vendorId   String?     // Vendor-specific policy ID
  rawConfig  Json?       // Store vendor-specific configuration
  cliConfig  String?     @db.Text // Store CLI configuration
  
  // Relationships
  ticket     ChangeTicket?
  deployments PolicyDeployment[]
}

enum PolicyAction {
  Allow
  Deny
}

enum PolicyStatus {
  Active
  Inactive
  PendingApproval @map("Pending Approval")
}

model Snapshot {
  id        String @id @default(cuid())
  version   String @unique
  comment   String
  author    String
  date      DateTime
  status    SnapshotStatus // 'Live' | 'Archived'
  createdAt DateTime @default(now())
}

enum SnapshotStatus {
  Live
  Archived
}

model Device {
  id          String   @id @default(cuid())
  name        String   @unique
  ip          String   @unique
  vendor      String?  // 'fortigate', 'paloalto', 'cisco'
  model       String?  // Device model
  version     String?  // Firmware version
  apiKey      String?  // API key for authentication
  status      DeviceStatus @default(Active)
  lastSync    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

enum DeviceStatus {
  Active
  Inactive
  Maintenance
  Error
}

model AddressObject {
  id          String @id // Use custom IDs like ADDR-001
  name        String
  type        AddressObjectType // 'IP/Range' | 'FQDN' | 'Geography'
  value       String
  description String
}

enum AddressObjectType {
  IPRange @map("IP/Range")
  FQDN
  Geography
}

model ServiceObject {
  id          String @id // Use custom IDs like SVC-001
  name        String
  protocol    ServiceProtocol // 'TCP' | 'UDP' | 'ICMP'
  portRange   String
  description String
}

enum ServiceProtocol {
  TCP
  UDP
  ICMP
}

model ObjectGroup {
  id          String @id // Use custom IDs like GRP-001
  name        String
  type        ObjectGroupType // 'Address' | 'Service'
  members     String[] // Array of IDs
  description String
}

enum ObjectGroupType {
  Address
  Service
}

model PolicyTemplate {
  id          String @id // Use custom IDs like TPL-001
  name        String
  description String
  category    PolicyTemplateCategory // 'Security' | 'Compliance' | 'Operations'
  policy      Json // Partial Policy as JSON
}

enum PolicyTemplateCategory {
  Security
  Compliance
  Operations
}

model ComplianceFramework {
  id          String @id @default(cuid())
  name        String @unique // e.g., "PCI DSS", "HIPAA", "GDPR", "ISO 27001"
  status      ComplianceStatus
  lastAudit   DateTime
  coverage    Int // Percentage 0-100
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relationship to controls
  controls    ComplianceControl[]
}

enum ComplianceStatus {
  Compliant
  NeedsReview @map("Needs Review")
  NonCompliant @map("Non-Compliant")
}

model ComplianceControl {
  id            String @id @default(cuid())
  controlId     String // e.g., "REQ-3.1", "164.312(a)(1)", "Art. 5"
  description   String
  status        ComplianceControlStatus
  frameworkId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relationship to framework
  framework     ComplianceFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  
  @@unique([controlId, frameworkId])
}

enum ComplianceControlStatus {
  Compliant
  NeedsReview @map("Needs Review")
  NonCompliant @map("Non-Compliant")
}

model ActivityLog {
  id        String @id @default(cuid())
  user      String
  action    String
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())
}

// User & Permission Management
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  Viewer
  Editor
  Admin
}

// Chat & Conversation History
model ChatConversation {
  id         String        @id @default(cuid())
  userId     String
  title      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  messages   ChatMessage[]
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String           @db.Text
  timestamp      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

enum MessageRole {
  User
  Assistant
}

// Change Ticket Management
model ChangeTicket {
  id           String           @id @default(cuid())
  ticketNumber String           @unique
  policyId     String?          @unique
  requestedBy  String
  title        String
  description  String           @db.Text
  status       TicketStatus
  priority     TicketPriority
  assignedTo   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  approvedAt   DateTime?
  deployedAt   DateTime?
  scheduledFor DateTime?
  
  // External ticket system integration
  externalSystem  String?        // 'servicenow', 'jira', 'internal'
  externalId      String?        // External ticket ID (e.g., CHG001234, PROJ-123)
  externalUrl     String?        // Link to external ticket
  lastSyncAt      DateTime?      // Last synchronization timestamp
  syncStatus      SyncStatus     @default(Pending)
  
  policy       Policy?          @relation(fields: [policyId], references: [id])
  comments     TicketComment[]
}

enum TicketStatus {
  Draft
  PendingApproval
  Approved
  Rejected
  Scheduled
  Deployed
  Failed
}

enum TicketPriority {
  Low
  Medium
  High
  Critical
}

enum SyncStatus {
  Pending
  Synced
  Failed
  Disabled
}

// External Ticket System Configuration
model ExternalTicketSystem {
  id          String   @id @default(cuid())
  name        String   @unique // 'servicenow', 'jira'
  displayName String   // 'ServiceNow', 'Jira'
  isActive    Boolean  @default(false)
  config      Json     // System-specific configuration
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TicketComment {
  id        String       @id @default(cuid())
  ticketId  String
  author    String
  content   String       @db.Text
  createdAt DateTime     @default(now())
  ticket    ChangeTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// Log Monitoring & Alerts
model FirewallLog {
  id          String      @id @default(cuid())
  timestamp   DateTime    @default(now())
  sourceIp    String
  destIp      String
  sourcePort  Int?
  destPort    Int?
  protocol    String
  action      LogAction
  policyId    String?
  deviceName  String
  severity    LogSeverity
  message     String?     @db.Text
}

enum LogAction {
  Allow
  Deny
  Drop
}

enum LogSeverity {
  Info
  Warning
  Critical
}

model Alert {
  id          String        @id @default(cuid())
  type        AlertType
  severity    AlertSeverity
  title       String
  description String        @db.Text
  source      String
  status      AlertStatus
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
}

enum AlertType {
  AnomalyDetected
  PolicyViolation
  ThresholdExceeded
  ConfigurationDrift
  FailedDeployment
}

enum AlertSeverity {
  Low
  Medium
  High
  Critical
}

enum AlertStatus {
  Open
  Acknowledged
  Resolved
  Suppressed
}

// Deployment & Audit Trail
model PolicyDeployment {
  id           String           @id @default(cuid())
  policyId     String
  ticketId     String?
  deployedBy   String
  deployedAt   DateTime         @default(now())
  status       DeploymentStatus
  targetDevice String
  errorMessage String?          @db.Text
  rollbackId   String?
  policy       Policy           @relation(fields: [policyId], references: [id])
}

enum DeploymentStatus {
  Pending
  InProgress
  Success
  Failed
  RolledBack
}

model AuditLog {
  id         String   @id @default(cuid())
  timestamp  DateTime  @default(now())
  userId     String
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
}
